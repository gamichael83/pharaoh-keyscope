<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Distributed directly (not sandboxed): ScreenCaptureKit system-audio
	     capture works without the sandbox, and the app needs no mic/camera. -->
	<key>com.apple.security.app-sandbox</key>
	<false/>
</dict>
</plist>
